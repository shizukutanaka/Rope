# Rope CI — Apple 的品質ゲート
#
# 全 PR + main push で実行。
# 4 ジョブ全 PASS が merge 条件。
#
# Apple の Xcode Cloud / TestFlight 相当:
# 「コードがきれい」と「コードが動く」は別の品質。両方必要。

name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: "-D warnings"

jobs:
  check:
    name: cargo check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.75.0
      - run: cargo check --all-targets

  test:
    name: cargo test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.75.0
      - run: cargo test --all-targets

  clippy:
    name: clippy
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.75.0
        with:
          components: clippy
      - run: cargo clippy --all-targets -- -D warnings

  fmt:
    name: rustfmt
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.75.0
        with:
          components: rustfmt
      - run: cargo fmt --all -- --check

  # Apple 的出荷判定: 全ジョブ green なら merge 可
  gate:
    name: quality gate
    needs: [check, test, clippy, fmt]
    runs-on: ubuntu-latest
    steps:
      - run: echo "✅ All quality gates passed"
