# Rope CI — Apple 的品質ゲート
#
# 全 push + 全 PR で実行 (現状 main ブランチが存在しないため push は
# ブランチ名を限定せず all-branches とする — main 作成後もこのままで動く)。
# 5 ジョブ全 PASS が merge 条件。
#
# Apple の Xcode Cloud / TestFlight 相当:
# 「コードがきれい」と「コードが動く」は別の品質。両方必要。

name: CI

on:
  push:
  pull_request:

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: "-D warnings"

jobs:
  check:
    name: cargo check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.86.0
      - run: cargo check --all-targets

  test:
    name: cargo test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.86.0
      - run: cargo test --all-targets

  test-http:
    name: cargo test (--features http)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.86.0
      - run: cargo test --all-targets --features http

  clippy:
    name: clippy
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.86.0
        with:
          components: clippy
      - run: cargo clippy --all-targets -- -D warnings
      - run: cargo clippy --all-targets --features http -- -D warnings

  fmt:
    name: rustfmt
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@1.86.0
        with:
          components: rustfmt
      - run: cargo fmt --all -- --check

  # Apple 的出荷判定: 全ジョブ green なら merge 可
  gate:
    name: quality gate
    needs: [check, test, test-http, clippy, fmt]
    runs-on: ubuntu-latest
    steps:
      - run: echo "✅ All quality gates passed"
