#!/usr/bin/env bash
# Rope の push 前ゲート (オプトイン)。
#
# 有効化:
#     git config core.hooksPath .githooks
# 無効化:
#     git config --unset core.hooksPath
# 1 回だけ回避:
#     git push --no-verify
#
# ## なぜこれが在るのか
#
# 本来の品質ゲートは GitHub Actions (`.github/ci.yml.disabled`) だが、
# この環境からは `workflows` 権限が無くて有効化できない
# (`docs/SURPLUS_AND_GAPS.md` §1.5)。**CI が使えるまでの代替**であって、
# 置き換えではない。CI が動き出したらこのフックは補助に降格してよい
# (数分の CI より 数秒のフックの方が編集中は速いので、残す価値はある)。
#
# ## 何を確認するか
#
# 1. rustfmt (構文と整形)
# 2. オフライン型検査 — `src/` 全体を rustc に通す
# 3. `src/` のテスト 358 件を**実際に実行** (core/ も含む)
# 4. clippy + **MSRV 1.75 適合検査** (`clippy-driver` は registry 不要)
# 5. `cargo` が使えるなら本物のゲート (build/test/clippy/fmt)
#
# 1-4 は crates.io 不要。5 は使える環境でだけ走る。
#
# ⚠️ 4 の clippy は toolchain 同梱の最新版で、**CI の 1.75 とは違う**。
#    提案を機械的に適用すると MSRV を壊すことがある (lint.sh 冒頭を参照)。

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

fail() {
    echo
    echo "❌ push 前ゲートで失敗: $1"
    echo "   直してから push してください (どうしても急ぐなら --no-verify)。"
    exit 1
}

echo "── 1/6 rustfmt ──"
mapfile -t rs_files < <(git ls-files 'src/*.rs' 'src/**/*.rs' 'examples/*.rs' 2>/dev/null)
if [ "${#rs_files[@]}" -gt 0 ]; then
    rustfmt --edition 2021 --check "${rs_files[@]}" || fail "rustfmt"
fi
echo "  OK"

echo "── 2/6 オフライン型検査 ──"
./tools/offline-typecheck/check.sh >/dev/null 2>&1 || {
    ./tools/offline-typecheck/check.sh
    fail "型検査"
}
echo "  OK"

echo "── 3/6 テストを実行 (src/ 全体) ──"
./tools/offline-typecheck/run-tests.sh >/dev/null 2>&1 || {
    ./tools/offline-typecheck/run-tests.sh
    fail "テスト"
}
echo "  OK"

echo "── 4/6 clippy + MSRV 1.75 ──"
./tools/offline-typecheck/lint.sh >/dev/null 2>&1 || {
    ./tools/offline-typecheck/lint.sh
    fail "clippy"
}
echo "  OK"

echo "── 5/6 依存グラフの MSRV (助言) ──"
# **push をブロックしない。** 理由は 2 つ:
#   1. index.crates.io への到達性に依存するので、ネットワーク事情で
#      push が止まるのは筋が悪い
#   2. 検出される違反は既知の未解決事項 (docs/SURPLUS_AND_GAPS.md §1.17)
#      であって、この push が持ち込んだ回帰ではない
# ただし**黙らせない** — 検出したら目立つ形で出す。
if ./tools/offline-typecheck/check-deps-msrv.sh >/tmp/rope-deps-msrv.$$ 2>&1; then
    echo "  OK (Cargo.lock の依存に MSRV 1.75 超は無し)"
else
    echo "  ⚠️  依存グラフに MSRV 1.75 超あり — CI を有効化すると落ちます。"
    echo "      詳細: docs/SURPLUS_AND_GAPS.md §1.17 (製品判断が要る)"
    sed -n '/^❌/,$p' /tmp/rope-deps-msrv.$$ | sed 's/^/      /'
    echo "      (push はブロックしません — 既知の未解決事項のため)"
fi
rm -f /tmp/rope-deps-msrv.$$

echo "── 6/6 cargo (使えれば) ──"
if cargo check --all-targets --offline >/dev/null 2>&1; then
    echo "  cargo が使えます。本物のゲートを回します。"
    cargo test --all-targets || fail "cargo test"
    cargo clippy --all-targets -- -D warnings || fail "clippy"
    cargo fmt --all -- --check || fail "cargo fmt"
    echo "  OK"
else
    echo "  スキップ (crates.io に到達できません — docs/SURPLUS_AND_GAPS.md §0)"
    echo "  ⚠️  型検査・テスト (既定 + --features http)・clippy・MSRV 1.75 は"
    echo "      通りましたが**スタブ経由**です。実 crate との挙動差・"
    echo "      暗号的性質・実 mint との通信は未確認。"
    echo "      MSRV は API 安定化表による検査で、1.75 で実際にビルドしたわけでは"
    echo "      ありません。clippy も CI の 1.75 とはバージョンが違います。"
fi

echo
echo "✅ push 前ゲート通過"
